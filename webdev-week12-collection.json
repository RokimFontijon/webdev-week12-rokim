                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Has pagination meta, 10 per page', function () { pm.expect(pm.response.json().meta.per_page).to.eql(10); });",
